local function refreshKeybind()
    keybind.Text = WaitingForKey
        and "PRESS A KEY..."
        or ("MENU KEY: " .. MenuKey.Name:upper())
end

keybind.MouseButton1Click:Connect(function()
    WaitingForKey = true
    refreshKeybind()
end)

UIS.InputBegan:Connect(function(input, processed)
    if WaitingForKey
        and input.UserInputType == Enum.UserInputType.Keyboard then
        MenuKey = input.KeyCode
        WaitingForKey = false
        refreshKeybind()
        return
    end

    if not processed
        and input.UserInputType == Enum.UserInputType.Keyboard
        and input.KeyCode == MenuKey then
        frame.Visible = not frame.Visible
        reopen.Visible = not frame.Visible
    end
end)

refreshKeybind()

-- JOUEURS ET REAPPARITIONS
local function setupPlayer(player)
    if player == LocalPlayer then return end

    local function onCharacter(character)
        character:WaitForChild("Humanoid", 10)
        character:WaitForChild("Head", 10)
        task.wait(0.2)
        updateCharacter(character)

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.HealthChanged:Connect(function()
                if HealthBarEnabled then
                    updateCharacter(character)
                end
            end)

            humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
                updateCharacter(character)
            end)
        end
    end

    player.CharacterAdded:Connect(onCharacter)

    if player.Character then
        task.spawn(onCharacter, player.Character)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

