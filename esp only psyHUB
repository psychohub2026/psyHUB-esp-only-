-- EFFETS VISUELS
local function removeNamed(character, name)
    local object = character:FindFirstChild(name)
    if object then object:Destroy() end
end

local function updateCharacter(character)
    if not character or not character.Parent then return end

    -- ESP GENERAL
    local highlight = character:FindFirstChild("psyHUBHighlight")

    if ESPEnabled then
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "psyHUBHighlight"
            highlight.Adornee = character
            highlight.Parent = character
        end

        highlight.Enabled = true
        highlight.FillColor = BodyColor
        highlight.OutlineColor = OutlineColor
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.DepthMode = WallhackEnabled
            and Enum.HighlightDepthMode.AlwaysOnTop
            or Enum.HighlightDepthMode.Occluded
    else
        removeNamed(character, "psyHUBHighlight")
    end

    -- CONTOURS DES PARTIES DU CORPS
    for _, partName in ipairs(BODY_PARTS) do
        local part = character:FindFirstChild(partName)
        local highlightName = "BodyESP_" .. partName:gsub("%s", "")

        if BodyPartsEnabled and part and part:IsA("BasePart") then
            local partHighlight = part:FindFirstChild(highlightName)

            if not partHighlight then
                partHighlight = Instance.new("Highlight")
                partHighlight.Name = highlightName
                partHighlight.Adornee = part
                partHighlight.Parent = part
            end

            partHighlight.Enabled = true
            partHighlight.FillColor = BodyColor
            partHighlight.OutlineColor = OutlineColor
            partHighlight.FillTransparency = 0.55
            partHighlight.OutlineTransparency = 0
            partHighlight.DepthMode = WallhackEnabled
                and Enum.HighlightDepthMode.AlwaysOnTop
                or Enum.HighlightDepthMode.Occluded
        elseif part then
            removeNamed(part, highlightName)
        end
    end

    -- BARRE DE VIE
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")
    local health = character:FindFirstChild("psyHUBHealth")

    if not HealthBarEnabled then
        if health then health:Destroy() end
    elseif humanoid and head then
        if not health then
            health = Instance.new("BillboardGui")
            health.Name = "psyHUBHealth"
            health.Adornee = head
            health.Size = UDim2.fromOffset(100, 10)
            health.StudsOffset = Vector3.new(0, 3, 0)
            health.AlwaysOnTop = true
            health.Parent = character

            local background = Instance.new("Frame")
            background.Name = "Background"
            background.Size = UDim2.fromScale(1, 1)
            background.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            background.BorderSizePixel = 0
            background.ClipsDescendants = true
            background.Parent = health
            Instance.new("UICorner", background).CornerRadius =
                UDim.new(0, 4)

            local bar = Instance.new("Frame")
            bar.Name = "Bar"
            bar.Size = UDim2.fromScale(1, 1)
            bar.BackgroundColor3 = Color3.fromRGB(40, 220, 70)
            bar.BorderSizePixel = 0
            bar.Parent = background
            Instance.new("UICorner", bar).CornerRadius =
                UDim.new(0, 4)
        end

        local bar = health.Background.Bar
        local ratio = math.clamp(
            humanoid.Health / math.max(humanoid.MaxHealth, 1),
            0, 1
        )
        bar.Size = UDim2.fromScale(ratio, 1)
        bar.BackgroundColor3 = ratio > 0.5
            and Color3.fromRGB(40, 220, 70)
            or (ratio > 0.25
                and Color3.fromRGB(255, 190, 30)
                or Color3.fromRGB(255, 45, 45))
    end
end

local function refreshAllVisuals()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            updateCharacter(player.Character)
        end
    end
end

-- CHOIX ENABLE / DISABLE
local function createChoice(labelText, y, getter, setter)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 40)
    row.Position = UDim2.fromOffset(0, y)
    row.BackgroundColor3 = Color3.fromRGB(25, 27, 41)
    row.BorderSizePixel = 0
    row.Parent = options
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -132, 1, 0)
    label.Position = UDim2.fromOffset(10, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(235, 236, 248)
    label.TextSize = 11
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local buttons = {}

    local function refresh()
        local enabled = getter()

        buttons[1].BackgroundColor3 = enabled
            and Color3.fromRGB(50, 175, 110)
            or Color3.fromRGB(48, 50, 70)

        buttons[2].BackgroundColor3 = not enabled
            and Color3.fromRGB(190, 60, 80)
            or Color3.fromRGB(48, 50, 70)
    end

    for i, state in ipairs({true, false}) do
        local button = Instance.new("TextButton")
        button.Size = UDim2.fromOffset(55, 26)
        button.Position = UDim2.new(
            1, -120 + (i - 1) * 60, 0.5, -13
        )
        button.BackgroundColor3 = Color3.fromRGB(48, 50, 70)
        button.Text = state and "ENABLE" or "DISABLE"
        button.TextColor3 = Color3.new(1, 1, 1)
        button.TextSize = 9
        button.Font = Enum.Font.GothamBold
        button.Parent = row
        Instance.new("UICorner", button).CornerRadius =
            UDim.new(0, 6)

        buttons[i] = button

        button.MouseButton1Click:Connect(function()
            setter(state)
            refreshAllVisuals()
            refresh()
        end)
    end

    refresh()
end

